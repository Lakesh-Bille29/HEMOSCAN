    <!-- About -->
    <string name="title_our_mission">हमारा मिशन</string>
    <string name="msg_our_mission">HemoScan में, हमारा मिशन चिकित्सा पेशेवरों को उन्नत AI तकनीक से सशक्त करना है।</string>
    <string name="title_our_team">हमारी टीम</string>
    <string name="msg_our_team">हम डेटा वैज्ञानिकों, न्यूरो-रेडियोलॉजिस्टों और सॉफ्टवेयर इंजीनियरों की एक विविध टीम हैं।</string>
    <string name="title_getting_started">शुरुआत कैसे करें</string>
    <string name="msg_getting_started">1. अपनी चिकित्सा साख के साथ खाता बनाएं।\n2. डैशबोर्ड पर जाएं और \'नया स्कैन\' पर क्लिक करें।\n3. CT इमेज अपलोड करें।\n4. AI मॉडल का परिणाम प्रतीक्षा करें।\n5. नैदानिक निष्कर्षों की समीक्षा करें।</string>
    <string name="title_troubleshooting">समस्या निवारण</string>
    <string name="msg_troubleshooting">- अपलोड विफल: स्थिर इंटरनेट कनेक्शन सुनिश्चित करें।\n- धीमी प्रोसेसिंग: 30 सेकंड तक प्रतीक्षा करें।\n- लॉगिन समस्या: \'पासवर्ड भूल गए\' लिंक उपयोग करें।</string>

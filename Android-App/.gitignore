# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik runtime
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio IDE files
*.iml
.idea/
.DS_Store
Thumbs.db

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Python virtual environments
venv/
.venv/
__pycache__/

# Google Services (contains API keys)
# google-services.json  # Keep this if no secrets, or add to gitignore if sensitive

# Keystore files
*.jks
*.keystore

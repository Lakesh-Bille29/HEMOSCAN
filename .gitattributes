# Handle line endings consistently across platforms
* text=auto

# PHP files - normalize to LF
*.php text eol=lf

# Python files - normalize to LF
*.py text eol=lf

# Web files - normalize to LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# SQL files
*.sql text eol=lf

# Java/Android - normalize to LF
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf

# Windows batch files - keep CRLF
*.bat text eol=crlf

# Binary files - no line ending conversion
*.tflite binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary
*.apk binary
*.aar binary
*.so binary
*.jar binary
*.zip binary
*.pdf binary

